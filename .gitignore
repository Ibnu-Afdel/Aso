# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Env / local
.env
*.sqlite
*.sqlite-journal

# Node
node_modules/
public/build/
public/hot

# Generated by `fastogram routes:generate` (T-28) -- rewritten from scratch on every run
resources/js/routes/
resources/js/actions/
resources/js/wayfinder/

# The skeleton template is never a buildable project in this repo: its own venv/lock/db are
# throwaway artifacts from running its tests, not framework state to track.
/skeleton/.venv/
/skeleton/uv.lock
/skeleton/database/database.sqlite
/skeleton/database/database.sqlite-*

# Spikes
spikes/**/server.log
spikes/**/server.pid
spikes/**/version.txt
spikes/**/package-lock.json
spikes/uv.lock

# Logs written by fixture apps (contents only, so a tracked `storage/logs/.gitkeep` survives --
# a directory-matching pattern here would exclude the whole directory and git cannot re-include
# a file whose parent directory is excluded)
storage/logs/*
**/storage/logs/*
!**/storage/logs/.gitkeep
