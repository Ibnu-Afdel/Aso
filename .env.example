APP_NAME=telegram-fastapi-template
ENVIRONMENT=development
DEBUG=true

TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_DELIVERY_MODE=polling
TELEGRAM_WEBHOOK_URL=https://your-domain.com/bot/webhook
TELEGRAM_WEBHOOK_SECRET=
# Set BOT_ENABLED=false for API-only dev (skips bot token validation)
BOT_ENABLED=true

# Use db:5432 for Docker, localhost:5432 for local dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/postgres
# Local dev (Postgres on host): postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://redis:6379/0

# Rate limit: memory (single process) or redis (multi-worker)
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_PER_MINUTE=30
